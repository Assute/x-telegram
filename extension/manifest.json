{
    "manifest_version": 3,
    "name": "x-telegram",
    "version": "0.2.9",
    "description": "在 X 媒体上添加上传到 Telegram 的按钮。",
    "permissions": [
        "storage",
        "webRequest"
    ],
    "host_permissions": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://pbs.twimg.com/*",
        "https://video.twimg.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "background": {
        "service_worker": "src/background/service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://x.com/*",
                "https://twitter.com/*"
            ],
            "js": [
                "src/content/x-page.js"
            ],
            "css": [
                "src/content/x-page.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "x-telegram",
        "default_popup": "src/options/options.html"
    },
    "options_page": "src/options/options.html"
}
